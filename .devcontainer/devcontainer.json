{
	"name": "Python 3.14 + Claude Code",
	// Compose brings up this dev container alongside a squid sidecar (see
	// docker-compose.yml) that intercepts outbound HTTP(S) traffic for
	// visibility. To override the app container's UID/GID to match your host
	// user (run `id -u` / `id -g` on your host), set USER_UID/USER_GID in the
	// environment or a .env file next to docker-compose.yml.
	"dockerComposeFile": "docker-compose.yml",
	"service": "app",
	"runServices": ["squid"],
	// Run as the non-root vscode user inside the container
	"remoteUser": "vscode",
	"workspaceFolder": "/workspaces/wonderwall",
	// Forward common dev ports – adjust as needed
	"forwardPorts": [],
	// VS Code extensions to install in the container
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
				"charliermarsh.ruff",
				"anthropic.claude-code"
			],
			"settings": {
				"terminal.integrated.defaultProfile.linux": "bash"
			}
		}
	},
	// Fix ownership of named volumes after they are first mounted, then trust
	// the squid sidecar's self-signed interception CA (mounted read-only from
	// the squid-ca-public volume) so proxy-aware tools accept its certs.
	// Runs once when the container is created (not on every start).
	"postCreateCommand": "sudo chown -R vscode:vscode /home/vscode/.claude /home/vscode/.bash_history_dir && sudo update-ca-certificates && echo 'Dev container ready. Run: claude' && python --version"
}